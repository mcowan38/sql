/* GROUP BY is mandatory any time a column aside from the one being aggregated is present
e.g., wanting to know the number of days in each month:
SELECT
COUNT(days)
,months

FROM calendar
GROUP by months */
-- Calculated PER GROUP

/* COUNT */
-- COUNT (*) FROM (table_name) will give you all the counts
-- No need for GROUP BY

/* 
SELECT
COUNT(days)
,COUNT(DISTINCT months) -- will be 12 (only unique)
,years

FROM calendar
GROUP BY months */

/* 1. Count the number of products */
 SELECT COUNT(product_id) as num_of_product
 FROM product;

 
/* 2. How many products per product_qty_type */
SELECT product_qty_type, COUNT(product_id) as num_of_product
FROM product
GROUP BY product_qty_type;


/* 3. How many products per product_qty_type and per their product_size */
SELECT product_size
,product_qty_type
,COUNT(product_id) as num_of_product
FROM product
GROUP BY product_size, product_qty_type

ORDER BY product_qty_type;


/* COUNT DISTINCT 
    4. How many unique products were bought */
SELECT COUNT(DISTINCT product_id) as bought_productsb -- if you remove DISTINCT: how many products bought vs. unique products
FROM customer_purchases

